{
    "name": "@nyar/nyar",
    "version": "0.0.22",
    "description": "Nyar VM host CLI (@vmz/commander) and orthogonal nyar-napi bindings.",
    "type": "module",
    "license": "MIT",
    "main": "./dist/index.js",
    "exports": {
        ".": "./dist/index.js",
        "./cli": "./dist/cli/cli.js"
    },
    "bin": {
        "nyar": "bin/nyar.js"
    },
    "files": [
        "bin",
        "dist",
        "src",
        "readme.md",
        "README.md"
    ],
    "scripts": {
        "build": "node ../../../../scripts/build-npm-package-js.mjs projects/nyar.ts/packages/nyar",
        "prepare": "node ../../../../scripts/build-npm-package-js.mjs projects/nyar.ts/packages/nyar",
        "prepack": "node ../../../../scripts/build-npm-package-js.mjs projects/nyar.ts/packages/nyar && node ../../../../scripts/prepare-npm-publish.mjs",
        "test": "node --experimental-strip-types --test tests/**/*.test.ts"
    },
    "dependencies": {
        "@vmz/commander": "^0.3.5",
        "@vmz/diagnostic": "^0.3.5"
    },
    "optionalDependencies": {
        "@nyar/nyar-darwin-arm64": "workspace:*",
        "@nyar/nyar-darwin-x64": "workspace:*",
        "@nyar/nyar-linux-x64": "workspace:*",
        "@nyar/nyar-unknown-wasm32": "workspace:*",
        "@nyar/nyar-win32-x64": "workspace:*"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "keywords": [
        "nyar",
        "nyar-vm",
        "virtual-machine",
        "runtime"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nyar-vm/nyar-vm.git",
        "directory": "projects/nyar.ts/packages/nyar"
    },
    "publishConfig": {
        "access": "public"
    }
}
