{
    "name": "@nyar/nyar",
    "version": "0.0.0",
    "description": "Nyar VM — cross-platform CLI (assembled from platform collects).",
    "type": "module",
    "license": "MIT",
    "main": "src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "bin": {
        "nyar": "bin/nyar.js"
    },
    "files": [
        "bin",
        "src",
        "readme.md",
        "README.md"
    ],
    "scripts": {
        "prepack": "node ../../../scripts/prepare-npm-publish.mjs"
    },
    "dependencies": {
        "@nyar/nyar-unknown-wasm32": "workspace:*"
    },
    "optionalDependencies": {
        "@nyar/nyar-win32-x64": "workspace:*",
        "@nyar/nyar-linux-x64": "workspace:*",
        "@nyar/nyar-darwin-x64": "workspace:*",
        "@nyar/nyar-darwin-arm64": "workspace:*"
    },
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "nyar",
        "nyar-vm",
        "virtual-machine",
        "runtime"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nyar-vm/nyar-vm.rs.git",
        "directory": "projects/packages/nyar"
    },
    "publishConfig": {
        "access": "public"
    }
}
