<widget hub><div class="hub-page">
<div class="hub-container">
<h1 class="hub-title">{title}</h1>
<p class="hub-subtitle">
    由
    <strong>legion doc</strong>
    生成
</p>
<div class="hub-cards">
    <a class="hub-card" :href="doc_href">
        <div class="hub-card-icon">DOC</div>
        <div class="hub-card-title">用户文档</div>
        <div class="hub-card-desc">{doc_desc}</div>
    </a>
</div>
</div>
</div>
</widget>
<style>.hub-page {
display: flex;
justify-content: center;
align-items: center;
min-height: 100vh;
padding: 2rem;
background: #ffffff;
color: #1a1a1a;
font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.hub-container {
max-width: 640px;
width: 100%;
text-align: center;
}
.hub-title {
font-size: 2rem;
margin-bottom: 0.5rem;
color: #c67b34;
}
.hub-subtitle {
color: #666;
margin-bottom: 2rem;
}
.hub-cards {
display: flex;
gap: 1.5rem;
justify-content: center;
flex-wrap: wrap;
}
.hub-card {
flex: 1;
min-width: 200px;
max-width: 280px;
background: #fafafa;
border: 1px solid #ddd;
border-radius: 8px;
padding: 2rem 1.5rem;
text-decoration: none;
transition: box-shadow 0.2s, transform 0.2s;
color: inherit;
}
.hub-card:hover {
box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
transform: translateY(-2px);
}
.hub-card-icon {
font-size: 2rem;
margin-bottom: 1rem;
color: #3873ad;
}
.hub-card-title {
font-size: 1.25rem;
font-weight: 600;
color: #3873ad;
margin-bottom: 0.5rem;
}
.hub-card-desc {
font-size: 0.9rem;
color: #666;
line-height: 1.5;
}
</style>

