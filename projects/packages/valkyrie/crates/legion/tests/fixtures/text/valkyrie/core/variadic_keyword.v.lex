Token { kind: Whitespace, span: 0..1, text: "\n" }
Token { kind: KeywordMicro, span: 1..6, text: "micro" }
Token { kind: Whitespace, span: 6..7, text: " " }
Token { kind: Identifier, span: 7..12, text: "merge" }
Token { kind: LParen, span: 12..13, text: "(" }
Token { kind: Identifier, span: 13..14, text: "a" }
Token { kind: Comma, span: 14..15, text: "," }
Token { kind: Whitespace, span: 15..16, text: " " }
Token { kind: LAngle, span: 16..17, text: "<" }
Token { kind: Comma, span: 17..18, text: "," }
Token { kind: Whitespace, span: 18..19, text: " " }
Token { kind: RAngle, span: 19..20, text: ">" }
Token { kind: Comma, span: 20..21, text: "," }
Token { kind: Whitespace, span: 21..22, text: " " }
Token { kind: Ellipsis, span: 22..25, text: "..." }
Token { kind: Identifier, span: 25..30, text: "pairs" }
Token { kind: RParen, span: 30..31, text: ")" }
Token { kind: Whitespace, span: 31..32, text: " " }
Token { kind: LBrace, span: 32..33, text: "{" }
Token { kind: Whitespace, span: 33..34, text: "\n" }
Token { kind: Whitespace, span: 34..35, text: " " }
Token { kind: Whitespace, span: 35..36, text: " " }
Token { kind: Whitespace, span: 36..37, text: " " }
Token { kind: Whitespace, span: 37..38, text: " " }
Token { kind: Identifier, span: 38..43, text: "pairs" }
Token { kind: Whitespace, span: 43..44, text: "\n" }
Token { kind: RBrace, span: 44..45, text: "}" }
Token { kind: Whitespace, span: 45..46, text: "\n" }
Token { kind: Whitespace, span: 46..47, text: "\n" }
Token { kind: Eof, span: 47..47, text: "" }
