Token { kind: Whitespace, span: 0..1, text: "\n" }
Token { kind: KeywordMicro, span: 1..3, text: "fn" }
Token { kind: Whitespace, span: 3..4, text: " " }
Token { kind: Identifier, span: 4..12, text: "identity" }
Token { kind: LAngle, span: 12..13, text: "<" }
Token { kind: Identifier, span: 13..14, text: "T" }
Token { kind: RAngle, span: 14..15, text: ">" }
Token { kind: LParen, span: 15..16, text: "(" }
Token { kind: Identifier, span: 16..21, text: "value" }
Token { kind: Colon, span: 21..22, text: ":" }
Token { kind: Whitespace, span: 22..23, text: " " }
Token { kind: Identifier, span: 23..24, text: "T" }
Token { kind: RParen, span: 24..25, text: ")" }
Token { kind: Whitespace, span: 25..26, text: " " }
Token { kind: Arrow, span: 26..28, text: "->" }
Token { kind: Whitespace, span: 28..29, text: " " }
Token { kind: Identifier, span: 29..30, text: "T" }
Token { kind: Whitespace, span: 30..31, text: " " }
Token { kind: LBrace, span: 31..32, text: "{" }
Token { kind: Whitespace, span: 32..33, text: "\n" }
Token { kind: Whitespace, span: 33..34, text: " " }
Token { kind: Whitespace, span: 34..35, text: " " }
Token { kind: Whitespace, span: 35..36, text: " " }
Token { kind: Whitespace, span: 36..37, text: " " }
Token { kind: Identifier, span: 37..42, text: "value" }
Token { kind: Whitespace, span: 42..43, text: "\n" }
Token { kind: RBrace, span: 43..44, text: "}" }
Token { kind: Whitespace, span: 44..45, text: "\n" }
Token { kind: Whitespace, span: 45..46, text: "\n" }
Token { kind: Eof, span: 46..46, text: "" }
