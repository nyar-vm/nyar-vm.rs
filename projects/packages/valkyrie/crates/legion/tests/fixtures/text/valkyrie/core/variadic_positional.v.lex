Token { kind: Whitespace, span: 0..1, text: "\n" }
Token { kind: KeywordMicro, span: 1..6, text: "micro" }
Token { kind: Whitespace, span: 6..7, text: " " }
Token { kind: Identifier, span: 7..10, text: "sum" }
Token { kind: LParen, span: 10..11, text: "(" }
Token { kind: DotDot, span: 11..13, text: ".." }
Token { kind: Identifier, span: 13..18, text: "items" }
Token { kind: Colon, span: 18..19, text: ":" }
Token { kind: Whitespace, span: 19..20, text: " " }
Token { kind: Identifier, span: 20..23, text: "i64" }
Token { kind: RParen, span: 23..24, text: ")" }
Token { kind: Whitespace, span: 24..25, text: " " }
Token { kind: LBrace, span: 25..26, text: "{" }
Token { kind: Whitespace, span: 26..27, text: "\n" }
Token { kind: Whitespace, span: 27..28, text: " " }
Token { kind: Whitespace, span: 28..29, text: " " }
Token { kind: Whitespace, span: 29..30, text: " " }
Token { kind: Whitespace, span: 30..31, text: " " }
Token { kind: Identifier, span: 31..36, text: "items" }
Token { kind: Whitespace, span: 36..37, text: "\n" }
Token { kind: RBrace, span: 37..38, text: "}" }
Token { kind: Whitespace, span: 38..39, text: "\n" }
Token { kind: Whitespace, span: 39..40, text: "\n" }
Token { kind: Eof, span: 40..40, text: "" }
