Token { kind: Identifier, span: 0..1, text: "a" }
Token { kind: Whitespace, span: 1..2, text: " " }
Token { kind: LAngle, span: 2..3, text: "<" }
Token { kind: Whitespace, span: 3..4, text: " " }
Token { kind: Identifier, span: 4..5, text: "b" }
Token { kind: Whitespace, span: 5..6, text: "\n" }
Token { kind: Eof, span: 6..6, text: "" }
