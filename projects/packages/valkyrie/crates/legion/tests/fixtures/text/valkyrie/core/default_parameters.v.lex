Token { kind: Whitespace, span: 0..1, text: "\n" }
Token { kind: KeywordMicro, span: 1..6, text: "micro" }
Token { kind: Whitespace, span: 6..7, text: " " }
Token { kind: Identifier, span: 7..12, text: "greet" }
Token { kind: LParen, span: 12..13, text: "(" }
Token { kind: Identifier, span: 13..17, text: "name" }
Token { kind: Colon, span: 17..18, text: ":" }
Token { kind: Whitespace, span: 18..19, text: " " }
Token { kind: Identifier, span: 19..23, text: "utf8" }
Token { kind: Whitespace, span: 23..24, text: " " }
Token { kind: Equal, span: 24..25, text: "=" }
Token { kind: Whitespace, span: 25..26, text: " " }
Token { kind: StringLiteral, span: 26..33, text: "\"world\"" }
Token { kind: RParen, span: 33..34, text: ")" }
Token { kind: Whitespace, span: 34..35, text: " " }
Token { kind: LBrace, span: 35..36, text: "{" }
Token { kind: Whitespace, span: 36..37, text: "\n" }
Token { kind: Whitespace, span: 37..38, text: " " }
Token { kind: Whitespace, span: 38..39, text: " " }
Token { kind: Whitespace, span: 39..40, text: " " }
Token { kind: Whitespace, span: 40..41, text: " " }
Token { kind: Identifier, span: 41..45, text: "name" }
Token { kind: Whitespace, span: 45..46, text: "\n" }
Token { kind: RBrace, span: 46..47, text: "}" }
Token { kind: Whitespace, span: 47..48, text: "\n" }
Token { kind: Whitespace, span: 48..49, text: "\n" }
Token { kind: Eof, span: 49..49, text: "" }
