Token { kind: LAngle, span: 0..1, text: "<" }
Token { kind: Identifier, span: 1..4, text: "div" }
Token { kind: Whitespace, span: 4..5, text: " " }
Token { kind: KeywordClass, span: 5..10, text: "class" }
Token { kind: Equal, span: 10..11, text: "=" }
Token { kind: StringLiteral, span: 11..16, text: "\"box\"" }
Token { kind: RAngle, span: 16..17, text: ">" }
Token { kind: LBrace, span: 17..18, text: "{" }
Token { kind: Identifier, span: 18..23, text: "count" }
Token { kind: RBrace, span: 23..24, text: "}" }
Token { kind: LAngle, span: 24..25, text: "<" }
Token { kind: Slash, span: 25..26, text: "/" }
Token { kind: Identifier, span: 26..29, text: "div" }
Token { kind: RAngle, span: 29..30, text: ">" }
Token { kind: Whitespace, span: 30..31, text: "\n" }
Token { kind: Eof, span: 31..31, text: "" }
