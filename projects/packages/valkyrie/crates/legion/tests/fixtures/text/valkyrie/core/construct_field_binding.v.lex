Token { kind: Whitespace, span: 0..1, text: "\n" }
Token { kind: KeywordMicro, span: 1..6, text: "micro" }
Token { kind: Whitespace, span: 6..7, text: " " }
Token { kind: Identifier, span: 7..11, text: "main" }
Token { kind: LParen, span: 11..12, text: "(" }
Token { kind: RParen, span: 12..13, text: ")" }
Token { kind: Whitespace, span: 13..14, text: " " }
Token { kind: LBrace, span: 14..15, text: "{" }
Token { kind: Whitespace, span: 15..16, text: "\n" }
Token { kind: Whitespace, span: 16..17, text: " " }
Token { kind: Whitespace, span: 17..18, text: " " }
Token { kind: Whitespace, span: 18..19, text: " " }
Token { kind: Whitespace, span: 19..20, text: " " }
Token { kind: Identifier, span: 20..25, text: "Point" }
Token { kind: Whitespace, span: 25..26, text: " " }
Token { kind: LBrace, span: 26..27, text: "{" }
Token { kind: Whitespace, span: 27..28, text: " " }
Token { kind: Identifier, span: 28..29, text: "y" }
Token { kind: Colon, span: 29..30, text: ":" }
Token { kind: Whitespace, span: 30..31, text: " " }
Token { kind: IntegerLiteral, span: 31..32, text: "2" }
Token { kind: Comma, span: 32..33, text: "," }
Token { kind: Whitespace, span: 33..34, text: " " }
Token { kind: Identifier, span: 34..35, text: "x" }
Token { kind: Colon, span: 35..36, text: ":" }
Token { kind: Whitespace, span: 36..37, text: " " }
Token { kind: IntegerLiteral, span: 37..38, text: "1" }
Token { kind: Whitespace, span: 38..39, text: " " }
Token { kind: RBrace, span: 39..40, text: "}" }
Token { kind: Whitespace, span: 40..41, text: "\n" }
Token { kind: RBrace, span: 41..42, text: "}" }
Token { kind: Whitespace, span: 42..43, text: "\n" }
Token { kind: Whitespace, span: 43..44, text: "\n" }
Token { kind: Eof, span: 44..44, text: "" }
