Token { kind: Identifier, span: 0..1, text: "a" }
Token { kind: Whitespace, span: 1..2, text: " " }
Token { kind: LessEq, span: 2..4, text: "<=" }
Token { kind: Whitespace, span: 4..5, text: " " }
Token { kind: Identifier, span: 5..6, text: "b" }
Token { kind: Whitespace, span: 6..7, text: "\n" }
Token { kind: Eof, span: 7..7, text: "" }
