Token { kind: Whitespace, span: 0..1, text: "\n" }
Token { kind: KeywordType, span: 1..5, text: "type" }
Token { kind: Whitespace, span: 5..6, text: " " }
Token { kind: Identifier, span: 6..15, text: "Composite" }
Token { kind: Whitespace, span: 15..16, text: " " }
Token { kind: Equal, span: 16..17, text: "=" }
Token { kind: Whitespace, span: 17..18, text: " " }
Token { kind: Identifier, span: 18..25, text: "Display" }
Token { kind: Whitespace, span: 25..26, text: " " }
Token { kind: Ampersand, span: 26..27, text: "&" }
Token { kind: Whitespace, span: 27..28, text: " " }
Token { kind: Identifier, span: 28..33, text: "Clone" }
Token { kind: Semicolon, span: 33..34, text: ";" }
Token { kind: Whitespace, span: 34..35, text: "\n" }
Token { kind: Whitespace, span: 35..36, text: "\n" }
Token { kind: Eof, span: 36..36, text: "" }
