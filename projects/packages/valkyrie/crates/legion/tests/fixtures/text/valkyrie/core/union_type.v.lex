Token { kind: Whitespace, span: 0..1, text: "\n" }
Token { kind: KeywordType, span: 1..5, text: "type" }
Token { kind: Whitespace, span: 5..6, text: " " }
Token { kind: Identifier, span: 6..9, text: "Mix" }
Token { kind: Whitespace, span: 9..10, text: " " }
Token { kind: Equal, span: 10..11, text: "=" }
Token { kind: Whitespace, span: 11..12, text: " " }
Token { kind: Identifier, span: 12..15, text: "i64" }
Token { kind: Whitespace, span: 15..16, text: " " }
Token { kind: Pipe, span: 16..17, text: "|" }
Token { kind: Whitespace, span: 17..18, text: " " }
Token { kind: Identifier, span: 18..22, text: "utf8" }
Token { kind: Semicolon, span: 22..23, text: ";" }
Token { kind: Whitespace, span: 23..24, text: "\n" }
Token { kind: Whitespace, span: 24..25, text: "\n" }
Token { kind: Eof, span: 25..25, text: "" }
