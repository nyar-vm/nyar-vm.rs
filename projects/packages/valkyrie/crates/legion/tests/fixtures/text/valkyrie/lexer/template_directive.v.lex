Token { kind: TemplateDirective, span: 0..14, text: "<% if debug %>" }
Token { kind: LAngle, span: 14..15, text: "<" }
Token { kind: Identifier, span: 15..18, text: "div" }
Token { kind: Slash, span: 18..19, text: "/" }
Token { kind: RAngle, span: 19..20, text: ">" }
Token { kind: Whitespace, span: 20..21, text: "\n" }
Token { kind: Eof, span: 21..21, text: "" }
