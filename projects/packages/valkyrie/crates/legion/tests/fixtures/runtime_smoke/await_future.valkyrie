trait Future {
    type Output

    micro poll(mut self) -> bool
}

class ReadyFuture {
    done: bool
}

imply ReadyFuture: Future {
    type Output = i32

    micro poll(mut self) -> bool {
        if !self.done {
            self.done = true
            return false
        }
        return true
    }
}

micro async_fn() {
    let future: Future<i32> = ReadyFuture { done: false }
    future.await
    return
}

[main]
micro main() {
    async_fn()
    print("suspend_ok")
    return
}
