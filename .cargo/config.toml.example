# 复制为 `.cargo/config.toml`（已 gitignore）。CI 不读此文件，直接用根 `Cargo.toml` 的 git 依赖。
# 按本机 monorepo 布局调整 path；示例假设与 `nyar-vm.rs` 同级的兄弟检出。

[registries.crates-io]
protocol = "sparse"

[patch."https://github.com/yggdrasil-language/oak.rs"]
oak-core = { path = "../oaks/projects/oak-core" }
oak-valkyrie = { path = "../oaks/examples/oak-valkyrie" }
oak-von = { path = "../oaks/examples/oak-von" }

[patch."https://github.com/yggdrasil-language/acorn.rs"]
acorn-wasm = { path = "../acorn.rs/examples/acorn-wasm" }
acorn-jvm = { path = "../acorn.rs/examples/acorn-jvm" }
acorn-pe = { path = "../acorn.rs/examples/acorn-pe" }
