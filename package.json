{
    "name": "@nyar/project-nyar",
    "version": "1.0.0",
    "private": true,
    "description": "Nyar Virtual Machine and Tooling",
    "scripts": {
        "test": "pnpm -r test",
        "build": "pnpm -r build",
        "build:napi": "node scripts/build.mjs napi",
        "build:wasm": "node scripts/build.mjs wasm",
        "build:native": "npx tsx scripts/build.ts",
        "migrate:compiler-flow": "node scripts/reshape-compiler-flow.mjs",
        "fmt": "nifty format",
        "fmt:check": "nifty format --check",
        "format": "nifty format",
        "lint": "biome check --apply .",
        "check": "cargo cry",
        "check:doc": "cargo-cry doc",
        "p": "cargo workspaces publish --no-git-commit --allow-dirty --yes",
        "u": "cargo upgrade --incompatible"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@doki-land/nifty": "^0.0.3",
        "typescript": "^5.0.0"
    },
    "packageManager": "pnpm@9.15.4"
}
